# Copy this file to .env and put your own key in .env. Never commit .env.

# --- Model provider (Groq free tier) ---
GROQ_API_KEY=your_key_here
MODEL_NAME=openai/gpt-oss-20b
LLM_PROVIDER=groq
LLM_TOKENS_PER_MINUTE=8000

# --- Embeddings and vector store ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_BACKEND=chroma

# --- Decisions (chosen with: python -m evaluation.tune) ---
CHUNK_STRATEGY=whole
RETRIEVAL_TOP_K=3
RELEVANCE_THRESHOLD=0.40
CONFIDENCE_THRESHOLD=0.50
ANSWERABLE_THRESHOLD=0.6
GROUNDING_MIN_OVERLAP=0.5

# --- Kill switch: set to false to stop all automatic answers ---
AUTO_RESPOND_ENABLED=true
